{
  "manifest_version": 3,
  "name": "InvimÁgil Inyector",
  "version": "0.3.0",
  "description": "Llena el trámite de NSO en InvimÁgil con la planilla aprobada en SPI Sistematización: pantalla por pantalla o de corrido hasta Términos, con mezclas y documentos. Nunca acepta términos ni radica.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://invimagil.invima.gov.co/*",
    "https://firebasestorage.googleapis.com/*"
  ],
  "action": {
    "default_title": "InvimÁgil Inyector"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://invimagil.invima.gov.co/*",
        "http://localhost:8765/tools/*"
      ],
      "js": [
        "content/engine.js",
        "content/filler.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://invimagil.invima.gov.co/*",
        "http://localhost:8765/tools/*"
      ],
      "js": [
        "main/apollo-reader.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://spi-sistematizaciones.web.app/*",
        "https://spi-sistematizaciones.firebaseapp.com/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content/puente.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mapa-formulario.json"
      ],
      "matches": [
        "https://invimagil.invima.gov.co/*",
        "http://localhost:8765/*"
      ]
    }
  ]
}
